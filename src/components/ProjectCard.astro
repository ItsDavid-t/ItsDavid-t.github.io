---
import TechBadge from './TechBadge.astro';
import Button from './Button.astro';
import { formatRepoName } from '../lib/projects';
import type { Project } from '../data/site';
import type { Translation } from '../data/translations/types';

interface Props {
  project: Project;
  t: Translation['projects'];
  locale: string;
}

const { project, t, locale } = Astro.props;

const content = t.items[project.id] ?? {
  name: formatRepoName(project.githubRepo),
  description: project.githubDescription ?? t.fallbackDescription,
};

const statusLabel = t.status[project.status];
const isActive = project.status === 'active';

const updatedLabel = project.githubUpdatedAt
  ? new Intl.DateTimeFormat(locale === 'es' ? 'es' : 'en', {
      month: 'short',
      year: 'numeric',
    }).format(new Date(project.githubUpdatedAt))
  : null;
---

<article class:list={['project-card', 'reveal', { 'project-card--featured': project.featured }]}>
  <div class="project-card__media">
    <img
      src={project.image}
      alt=""
      width="640"
      height="400"
      loading="lazy"
      decoding="async"
    />
    <span class:list={['project-card__status', `project-card__status--${project.status}`]}>
      {statusLabel}
    </span>
    {
      project.syncedFromGitHub && (
        <span class="project-card__sync" title="Synced from GitHub">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </span>
      )
    }
  </div>

  <div class="project-card__body">
    <div class="project-card__header">
      <h3 class="project-card__title">{content.name}</h3>
      {updatedLabel && (
        <p class="project-card__updated">{t.updated} {updatedLabel}</p>
      )}
    </div>
    <p class="project-card__description">{content.description}</p>

    {
      project.technologies.length > 0 && (
        <ul class="project-card__tech" aria-label="Technologies">
          {project.technologies.map((tech) => (
            <li>
              <TechBadge label={tech} />
            </li>
          ))}
        </ul>
      )
    }

    <div class="project-card__actions">
      <Button href={project.github} variant={isActive ? 'primary' : 'secondary'} external>
        {t.viewGithub}
      </Button>
      {
        project.demo && (
          <Button href={project.demo} variant="ghost" external>
            {t.viewDemo}
          </Button>
        )
      }
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    background: var(--gradient-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition:
      border-color var(--transition-base),
      transform var(--transition-base),
      box-shadow var(--transition-base);
  }

  .project-card:hover {
    border-color: var(--color-border-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .project-card--featured {
    border-color: var(--color-border-strong);
  }

  .project-card__media {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--color-bg-elevated);
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }

  .project-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .project-card:hover .project-card__media img {
    transform: scale(1.02);
  }

  .project-card__status {
    position: absolute;
    top: var(--space-md);
    left: var(--space-md);
    padding: 0.375rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-radius: var(--radius-sm);
    backdrop-filter: blur(8px);
  }

  .project-card__status--active {
    color: var(--color-success);
    background: var(--color-success-muted);
    border: 1px solid rgba(52, 211, 153, 0.2);
  }

  .project-card__status--in-development {
    color: var(--color-warning);
    background: var(--color-warning-muted);
    border: 1px solid rgba(251, 191, 36, 0.2);
  }

  .project-card__status--planned {
    color: var(--color-text-muted);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
  }

  .project-card__sync {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    color: var(--color-text-muted);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    backdrop-filter: blur(8px);
  }

  .project-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--space-md);
    padding: var(--space-xl);
  }

  .project-card__header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .project-card__title {
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .project-card__updated {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-subtle);
    letter-spacing: 0.02em;
  }

  .project-card__description {
    color: var(--color-text-muted);
    line-height: 1.65;
    flex: 1;
  }

  .project-card__tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .project-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding-top: var(--space-sm);
  }
</style>
