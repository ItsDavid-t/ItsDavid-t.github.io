---
import { siteConfig } from '../data/site';

interface Props {
  size?: 'sm' | 'md' | 'lg' | 'xl';
  showBrand?: boolean;
  class?: string;
}

const { size = 'md', showBrand = false, class: className = '' } = Astro.props;

const sizes = {
  sm: 36,
  md: 48,
  lg: 80,
  xl: 112,
} as const;

const dimension = sizes[size];
---

<div class:list={['avatar', `avatar--${size}`, className]}>
  <img
    src={siteConfig.avatar.src}
    alt={siteConfig.avatar.alt}
    width={dimension}
    height={dimension}
    loading={size === 'xl' ? 'eager' : 'lazy'}
    decoding="async"
    class="avatar__image"
  />
  {
    showBrand && (
      <span class="avatar__brand" aria-hidden="true" title="Personal brand">
        {siteConfig.brand.mark}
      </span>
    )
  }
</div>

<style>
  .avatar {
    position: relative;
    flex-shrink: 0;
  }

  .avatar__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 2px solid var(--color-border-strong);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .avatar--sm {
    width: 2.25rem;
    height: 2.25rem;
  }

  .avatar--md {
    width: 3rem;
    height: 3rem;
  }

  .avatar--lg {
    width: 5rem;
    height: 5rem;
  }

  .avatar--xl {
    width: 7rem;
    height: 7rem;
  }

  .avatar__brand {
    position: absolute;
    right: -0.125rem;
    bottom: -0.125rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.625rem;
    height: 1.625rem;
    font-size: 0.875rem;
    line-height: 1;
    background: var(--color-surface);
    border: 2px solid var(--color-border-strong);
    border-radius: 50%;
    box-shadow: var(--shadow-sm);
  }

  .avatar--lg .avatar__brand,
  .avatar--xl .avatar__brand {
    width: 2rem;
    height: 2rem;
    font-size: 1rem;
    right: 0;
    bottom: 0;
  }
</style>
