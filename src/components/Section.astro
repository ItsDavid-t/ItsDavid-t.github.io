---
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  class?: string;
}

const { id, eyebrow, title, class: className = '' } = Astro.props;
---

<section id={id} class:list={['section', className]}>
  <div class="container">
    {eyebrow && <p class="section-eyebrow reveal">{eyebrow}</p>}
    {title && <h2 class="section-title reveal">{title}</h2>}
    <slot />
  </div>
</section>
