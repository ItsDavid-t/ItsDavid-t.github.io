---
import Button from './Button.astro';
import Avatar from './Avatar.astro';
import { siteConfig } from '../data/site';
import type { Translation } from '../data/translations/types';

interface Props {
  t: Translation;
}

const { t } = Astro.props;
---

<section id="home" class="hero">
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__grid"></div>
    <div class="hero__glow"></div>
  </div>

  <div class="container hero__content">
    <div class="hero__text">
      <div class="hero__identity reveal">
        <Avatar size="xl" showBrand />
        <div class="hero__identity-text">
          <p class="hero__eyebrow">
            <span class="hero__brand-mark" aria-hidden="true">{siteConfig.brand.mark}</span>
            {t.hero.role}
          </p>
          <h1 class="hero__name">{siteConfig.name}</h1>
        </div>
      </div>

      <p class="hero__subtitle reveal">{t.hero.headline}</p>
      <p class="hero__supporting reveal">{t.hero.supporting}</p>

      <div class="hero__actions reveal">
        <Button href="#projects" variant="primary" size="lg">{t.hero.viewWork}</Button>
        <Button href={siteConfig.social.github} variant="secondary" size="lg" external>
          {t.hero.github}
        </Button>
      </div>
    </div>

    <div class="hero__visual reveal" aria-hidden="true">
      <div class="product-panel">
        <div class="product-panel__header">
          <span class="product-panel__dot product-panel__dot--red"></span>
          <span class="product-panel__dot product-panel__dot--yellow"></span>
          <span class="product-panel__dot product-panel__dot--green"></span>
          <span class="product-panel__label">
            {siteConfig.brand.mark} echo/products
          </span>
        </div>
        <div class="product-panel__body">
          <div class="product-panel__line product-panel__line--accent"></div>
          <div class="product-panel__line"></div>
          <div class="product-panel__line product-panel__line--short"></div>
          <div class="product-panel__cards">
            <div class="mini-card">
              <span class="mini-card__icon">◈</span>
              <span>Echo Stock</span>
            </div>
            <div class="mini-card mini-card--active">
              <span class="mini-card__icon">◈</span>
              <span>Echo Fix</span>
            </div>
          </div>
          <div class="product-panel__line product-panel__line--short"></div>
          <div class="product-panel__line"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-block: calc(var(--nav-height) + var(--space-3xl)) var(--space-3xl);
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--color-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, black, transparent);
    opacity: 0.5;
  }

  .hero__glow {
    position: absolute;
    inset: 0;
    background: var(--gradient-hero);
  }

  .hero__content {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3xl);
    align-items: center;
  }

  .hero__identity {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
  }

  .hero__identity-text {
    min-width: 0;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 0.375rem;
  }

  .hero__brand-mark {
    font-size: 1rem;
    line-height: 1;
  }

  .hero__name {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .hero__subtitle {
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.45;
    color: var(--color-text-muted);
    max-width: 36rem;
    margin-bottom: var(--space-md);
  }

  .hero__supporting {
    max-width: 32rem;
    color: var(--color-text-subtle);
    margin-bottom: var(--space-xl);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .hero__visual {
    justify-self: center;
    width: min(100%, 26rem);
  }

  .product-panel {
    background: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .product-panel__header {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.875rem 1rem;
    background: var(--color-bg-elevated);
    border-bottom: 1px solid var(--color-border);
  }

  .product-panel__dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    opacity: 0.7;
  }

  .product-panel__dot--red { background: #ff5f57; }
  .product-panel__dot--yellow { background: #febc2e; }
  .product-panel__dot--green { background: #28c840; }

  .product-panel__label {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-subtle);
  }

  .product-panel__body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .product-panel__line {
    height: 0.5rem;
    background: var(--color-border);
    border-radius: var(--radius-sm);
    opacity: 0.6;
  }

  .product-panel__line--accent {
    width: 40%;
    background: var(--color-accent-muted);
    opacity: 1;
  }

  .product-panel__line--short {
    width: 65%;
  }

  .product-panel__cards {
    display: grid;
    gap: 0.5rem;
    margin-block: 0.25rem;
  }

  .mini-card {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-base);
  }

  .mini-card--active {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-accent-muted);
  }

  .mini-card__icon {
    font-size: 0.875rem;
    opacity: 0.8;
  }

  @media (min-width: 960px) {
    .hero__content {
      grid-template-columns: 1.1fr 0.9fr;
    }

    .hero__visual {
      justify-self: end;
    }
  }
</style>
