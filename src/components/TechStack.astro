---
import Section from './Section.astro';
import TechBadge from './TechBadge.astro';
import { siteConfig } from '../data/site';
import type { Translation } from '../data/translations/types';

interface Props {
  t: Translation['stack'];
}

const { t } = Astro.props;
---

<Section id="stack" eyebrow={t.eyebrow} title={t.title}>
  <div class="stack-grid">
    {
      siteConfig.techGroups.map((group, index) => (
        <div class="stack-group reveal" style={`--delay: ${index * 80}ms`}>
          <h3 class="stack-group__title">{t.groups[group.id]}</h3>
          <ul class="stack-group__list">
            {group.technologies.map((tech) => (
              <li>
                <TechBadge label={tech} />
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>

<style>
  .stack-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  .stack-group {
    padding: var(--space-xl);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition:
      border-color var(--transition-base),
      transform var(--transition-base);
  }

  .stack-group:hover {
    border-color: var(--color-border-strong);
    transform: translateY(-1px);
  }

  .stack-group__title {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin-bottom: var(--space-md);
  }

  .stack-group__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  @media (min-width: 640px) {
    .stack-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .stack-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
